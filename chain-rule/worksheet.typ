#let L-CHAIN = ([إذا كانت $y = f(g(x))$ فإن مشتقتها تساوي], $display(y' = f'(g(x)) dot g'(x))$)
#let L-LEIB = ([إذا كانت $y = f(u)$ و $u = g(x)$ فإن], $display((d y)/(d x) = (d y)/(d u) dot (d u)/(d x))$)
#let L-POW = ([مشتقة القوة المركّبة], $display(d/(d x) [g(x)]^n = n [g(x)]^(n-1) dot g'(x))$)
#let L-SQ = ([مشتقة الجذر التربيعي المركّب], $display(d/(d x) sqrt(g(x)) = (g'(x))/(2 sqrt(g(x))))$)
#let L-TRIG = ([مشتقة الجيب وجيب التمام], $display(d/(d x) sin g(x) = g'(x) cos g(x))$)
#let L-COS = ([مشتقة جيب التمام], $display(d/(d x) cos g(x) = -g'(x) sin g(x))$)
#let L-EXP = ([مشتقة الدالة الأسية المركّبة], $display(d/(d x) e^(g(x)) = g'(x) e^(g(x)))$)
#let L-TAN = ([معادلة المماس عند $x = a$], $y - f(a) = f'(a) (x - a)$)
#let L-VAL = ([ميل المماس عند $x = a$ يساوي], $f'(a)$)

#question("الأول", "أساسي", laws: (L-POW,),
  [إذا كانت $f(x) = (3x + 1)^5$ فإن $f'(x)$ تساوي:],
  ($5(3x+1)^4$, $15(3x+1)^4$, $15(3x+1)^5$, $3(3x+1)^4$))

#question("الثاني", "متوسط", laws: (L-SQ,),
  [إذا كانت $f(x) = sqrt(x^2 + 4)$ فإن $f'(2)$ تساوي:],
  ($sqrt(2)/8$, $sqrt(2)$, $sqrt(2)/2$, $4 sqrt(2)$))

#question("الثالث", "متقدم", laws: (L-TRIG,),
  [إذا كانت $y = sin^3 (2x)$ فإن $display((d y)/(d x))$ تساوي:],
  ($3 sin^2 (2x) cos(2x)$, $6 sin^2 (2x)$, $6 sin^2 (2x) cos(2x)$, $3 sin^2 (2x)$))

