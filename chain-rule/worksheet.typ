#question("الرابع", "أساسي", laws: (L-COS,),
  [إذا كانت $y = cos(5x)$ فإن $y'$ تساوي:],
  ($5 sin(5x)$, $-sin(5x)$, $-5 cos(5x)$, $-5 sin(5x)$))

#question("الخامس", "متوسط", laws: (L-EXP,),
