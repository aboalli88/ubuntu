#let LAW-CP = ([قاعدة السلسلة للقوة], $d/(d x) [u(x)]^n = n [u(x)]^(n-1) u'(x)$)
#let LAW-CH = ([قاعدة السلسلة للدالة المركبة], $d/(d x) f(g(x)) = f'(g(x)) dot g'(x)$)
#let LAW-LB = ([قاعدة السلسلة بصيغة لايبنتز], $(d y)/(d x) = (d y)/(d u) dot (d u)/(d x)$)
#let LAW-RT = ([مشتقة الجذر التربيعي المركب], $d/(d x) sqrt(u) = (u')/(2 sqrt(u))$)
#let LAW-EX = ([مشتقة الدالة الأسية الطبيعية المركبة], $d/(d x) e^u = e^u dot u'$)
#let LAW-P = ([قاعدة الضرب], $(u v)' = u' v + u v'$)
#let LAW-H = ([المماس الأفقي: الميل يساوي صفرًا], $f'(x) = 0$)
#let LAW-SL = ([ميل المماس يساوي المشتقة عند نقطة التماس], $m = f'(a)$)
#let LAW-TAN = ([معادلة المماس عند $x = a$], $y - f(a) = f'(a)(x - a)$)
#let LAW-PW = ([تحويل الجذور والكسور إلى أسس قبل الاشتقاق], $root(n, x^m) = x^(m/n) quad 1/x^n = x^(-n)$)

