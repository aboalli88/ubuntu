#sol("الصفحة الرابعة: السؤال الأول", "أساسي")[
  $d/(d x) e^(x^2) = e^(x^2) dot 2x = 2x e^(x^2)$. *الجواب: B*
  #distract[A نسيان مشتقة الأس. C خطأ في الأس. D مشتقة الأس فقط.]
]
#sol("الصفحة الرابعة: السؤال الثاني", "متوسط")[
