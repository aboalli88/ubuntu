#sol("الصفحة الأولى: السؤال الأول", "أساسي")[
  $u = x^2 + 1$ و $v = x - 3$، فإن $u' = 2x$ و $v' = 1$. \
  $f'(x) = 2x(x - 3) + (x^2 + 1)(1) = 3x^2 - 6x + 1$. *الجواب: C*
  #distract[A ضرب المشتقتين $u' v'$. B إشارة سالبة في الحد الثاني. D فك الأقواس دون اشتقاق.]
]
#sol("الصفحة الأولى: السؤال الثاني", "متوسط")[
  $[u v]'(2) = u'(2) v(2) + u(2) v'(2) = (-2)(4) + (3)(5) = 7$. *الجواب: B*
  #distract[A $u' v' = (-2)(5)$. C $u' v - u v'$. D $u v' - u' v$.]
]
#sol("الصفحة الأولى: السؤال الثالث", "متقدم")[
  $u = x^2 + 1$ و $v = x^3 - x$، فإن $u' = 2x$ و $v' = 3x^2 - 1$. \
  $f'(2) = (4)(6) + (5)(11) = 24 + 55 = 79$. *الجواب: C*
  #distract[A $u' v' = 4 dot 11$. B $u' v - u v' = 24 - 55$. D $u v = 5 dot 6$.]
]
#pagebreak()
#sol("الصفحة الثانية: السؤال الأول", "أساسي")[
  $g'(x) = 3x^2 (2x + 5) + x^3 (2) = 6x^3 + 15x^2 + 2x^3 = 8x^3 + 15x^2$. *الجواب: B*
  #distract[A $u' v' = 3x^2 dot 2$. C الحد $u' v$ فقط. D الحد $u v'$ فقط.]
]
#sol("الصفحة الثانية: السؤال الثاني", "متوسط")[
  $h'(x) = (2x + 3)(x^2 - 2) + (x^2 + 3x)(2x)$. \
  $h'(1) = (5)(-1) + (4)(2) = -5 + 8 = 3$. *الجواب: A*
  #distract[B $u' v - u v' = -5 - 8$. C $u' v' = 5 dot 2$. D $u v' - u' v = 8 + 5$.]
]
#sol("الصفحة الثانية: السؤال الثالث", "متقدم")[
  $f'(x) = 2x e^x + x^2 e^x = e^x (x^2 + 2x) = e^x x (x + 2)$. \
  $e^x > 0$ دائمًا، فإن $f'(x) = 0$ عندما $x = 0$ أو $x = -2$. *الجواب: C*
  #distract[A و B حل واحد فقط من الحلين. D خطأ في إشارة العامل $(x + 2)$.]
]
#pagebreak()
#sol("الصفحة الثالثة: السؤال الأول (من الكتاب)", "أساسي")[
  $f'(x) = 2x (3 - x^3) + x^2 (-3x^2) = 6x - 2x^4 - 3x^4 = 6x - 5x^4$. *الجواب: C*
  #distract[A نسيان $-2x^4$ الناتج من $2x dot (-x^3)$. B و D خطأ في توزيع $2x (3 - x^3)$ أو جمع الحدود المتشابهة.]
]
#sol("الصفحة الثالثة: السؤال الثاني (من الكتاب)", "متوسط")[
  $[f g]'(2) = f'(2) g(2) + f(2) g'(2) = (-1)(5) + (3)(4) = 7$. *الجواب: B*
  #distract[D الحد $f g' = 3 dot 4 = 12$ فقط. A و C خطأ في الإشارة أو في ضرب $f'$ في $g$.]
]
#sol("الصفحة الثالثة: السؤال الثالث (من الكتاب)", "متوسط")[
  $y'(2) = u'(2) v(2) + u(2) v'(2) = (-3)(4) + (5)(1) = -12 + 5 = -7$. *الجواب: C*
  #distract[D $17 = 12 + 5$ بإشارة خاطئة للحد $u' v$. A و B خطأ في الضرب أو الجمع.]
]
#pagebreak()
#sol("الصفحة الرابعة: السؤال الأول (من الكتاب)", "متوسط")[
  $y' = 2(x^2 - 3) + (2x + 1)(2x)$. عند $x = 1$: $y'(1) = 2(-2) + (3)(2) = -4 + 6 = 2$. *الجواب: C*
  #distract[A الحد الأول فقط. B جمع غير صحيح. D الحد الثاني فقط.]
]
#sol("الصفحة الرابعة: السؤال الثاني", "متوسط")[
  $f'(x) = 3x^2 (x^2 - 4) + x^3 (2x)$. عند $x = -1$: $(3)(-3) + (-1)(-2) = -9 + 2 = -7$. *الجواب: D*
  #distract[A $u' v' = 3 dot (-2)$. B $u' v - u v' = -9 - 2$. C $u v' - u' v = 2 + 9$.]
]
#sol("الصفحة الرابعة: السؤال الثالث", "متقدم")[
  $f'(x) = 2x (x - 2) + (x^2 + a)(1)$. \
  $f'(1) = -2 + 1 + a = a - 1 = 4$ فإن $a = 5$. *الجواب: C*
  #distract[A و B و D خطأ في جمع $-2 + 1$ أو نقل الحدود.]
]
#pagebreak()
#sol("حل السؤال التالي: الأصلي", "متقدم")[
  #part("A")[$u = 2x - 1$ و $v = x^2 + 3x$، فإن $u' = 2$ و $v' = 2x + 3$. \
    $f'(x) = 2(x^2 + 3x) + (2x - 1)(2x + 3) = 2x^2 + 6x + 4x^2 + 4x - 3 = 6x^2 + 10x - 3$.]
  #part("B")[$m = f'(1) = 6 + 10 - 3 = 13$.]
  #part("C")[$f(1) = (1)(4) = 4$. المعادلة: $y - 4 = 13(x - 1)$ أي $y = 13x - 9$.]
]
#sol("حل السؤال التالي: المشابه الأول", "متوسط")[
  #part("A")[$u' v + u v' = (5)(-3) + (2)(4) = -15 + 8 = -7$.]
  #part("B")[$2x u + x^2 u' = (6)(2) + (9)(5) = 12 + 45 = 57$.]
  #part("C")[$g(3) = (2)(-3) = -6$ و $g'(3) = -7$. المعادلة: $y + 6 = -7(x - 3)$ أي $y = -7x + 15$.]
]
#pagebreak()
#sol("حل السؤال التالي: المشابه الثاني (من الكتاب)", "متوسط")[
  #part("A")[$f'(x) = 2x (3 - 2x) + (x^2 + 5)(-2) = 6x - 4x^2 - 2x^2 - 10 = -6x^2 + 6x - 10$.]
  #part("B")[$h'(x) = 3x^2 (x^2 - 4) + x^3 (2x)$ فإن $h'(-1) = (3)(-3) + (-1)(-2) = -9 + 2 = -7$.]
  #part("C")[$h(-1) = (-1)(-3) = 3$. المعادلة: $y - 3 = -7(x + 1)$ أي $y = -7x - 4$.]
]
#sol("حل السؤال التالي: المشابه الثالث", "متقدم")[
  #part("A")[$R'(t) = (1)(50 - 2t) + (t + 1)(-2) = 50 - 2t - 2t - 2 = 48 - 4t$.]
  #part("B")[$R'(3) = 48 - 12 = 36$. يزداد الإيراد بمعدل 36 ألف دينار لكل شهر عند $t = 3$.]
  #part("C")[$48 - 4t = 0$ فإن $t = 12$. يتوقف الإيراد عن الزيادة عند الشهر 12.]
]
