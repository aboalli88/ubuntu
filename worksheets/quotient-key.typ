#import "common.typ": *
#show: setup.with("الدرس 2-4: قاعدة القسمة", kind: "مفتاح الإجابة")
#set text(size: 17pt)

#align(center, table(columns: (auto,) * 4, align: center + horizon, inset: 6pt, stroke: 0.6pt,
  [*الصفحة*], [*الأول*], [*الثاني*], [*الثالث*],
  [الأولى], [C], [C], [D],
  [الثانية], [A], [C], [D],
  [الثالثة], [C], [D], [B],
  [الرابعة], [C], [B], [C]))
#v(4pt)

#sol("الصفحة الأولى: السؤال الأول", "أساسي")[
  $u = 3x$ و $v = x + 2$، فإن $u' = 3$ و $v' = 1$. \
  $f'(x) = (3(x + 2) - 3x (1))/(x + 2)^2 = 6/(x + 2)^2$. *الجواب: C*
  #distract[A $u' / v'$. B ترتيب معكوس $u v' - u' v$. D إشارة موجبة في البسط.]
]
#sol("الصفحة الأولى: السؤال الثاني", "متوسط")[
  $[u / v]'(2) = (u' v - u v')/v^2 = ((-3)(2) - (6)(4))/(2)^2 = (-30)/4 = -15/2$. *الجواب: C*
  #distract[A ترتيب معكوس. B نسيان تربيع المقام. D $u' / v'$.]
]
#sol("الصفحة الأولى: السؤال الثالث", "متقدم")[
  $f'(x) = (2x (x^2 + 1) - (x^2 - 1)(2x))/(x^2 + 1)^2 = (4x)/(x^2 + 1)^2$. \
  عند $x = 2$: $8/25$. *الجواب: D*
  #distract[A نسيان تربيع المقام: $8/5$. B $u' / v' = 2x / 2x = 1$. C ترتيب معكوس.]
]
#pagebreak()
#sol("الصفحة الثانية: السؤال الأول", "أساسي")[
  $g'(x) = (2x (x - 1) - x^2 (1))/(x - 1)^2 = (x^2 - 2x)/(x - 1)^2$. *الجواب: A*
  #distract[B إشارة موجبة في البسط. C مشتقة البسط فقط. D نسيان تربيع المقام.]
]
#sol("الصفحة الثانية: السؤال الثاني", "متوسط")[
  $f'(x) = (2(x - 2) - (2x + 3)(1))/(x - 2)^2 = (-7)/(x - 2)^2$. عند $x = 4$: $-7/4$. *الجواب: C*
  #distract[A ترتيب معكوس. B نسيان تربيع المقام. D $u' / v'$.]
]
#sol("الصفحة الثانية: السؤال الثالث", "متقدم")[
  $f'(x) = ((x^2 + 1) - x (2x))/(x^2 + 1)^2 = (1 - x^2)/(x^2 + 1)^2$. \
  $f'(x) = 0$ عندما $1 - x^2 = 0$ أي $x = 1$ أو $x = -1$. *الجواب: D*
  #distract[A و B جذر واحد فقط. C $x = 0$ يعطي $f'(0) = 1 eq.not 0$.]
]
#pagebreak()
#sol("الصفحة الثالثة: السؤال الأول (من الكتاب)", "أساسي")[
  $(d y)/(d x) = ((1)(x + 3) - x (1))/(x + 3)^2 = 3/(x + 3)^2$. *الجواب: C*
  #distract[A ترتيب معكوس $u v' - u' v$. B البسط $u'$ فقط. D جمع بدل طرح في البسط.]
]
#sol("الصفحة الثالثة: السؤال الثاني (من الكتاب)", "متوسط")[
  $[f / g]'(2) = (f' g - f g')/g^2 = ((-1)(5) - (3)(4))/(5)^2 = (-17)/25$. *الجواب: D*
  #distract[A ترتيب معكوس $f g' - f' g$. B جمع بدل طرح. C نسيان تربيع المقام.]
]
#sol("الصفحة الثالثة: السؤال الثالث (من الكتاب)", "متوسط")[
  $u = 3$ و $v = x^2 + 1$، فإن $u' = 0$ و $v' = 2x$. \
  $g'(x) = (0 - 3 (2x))/(x^2 + 1)^2 = (-6x)/(x^2 + 1)^2$. *الجواب: B*
  #distract[A إشارة موجبة. C نسيان $v'$ في البسط. D نسيان تربيع المقام.]
]
#pagebreak()
#sol("الصفحة الرابعة: السؤال الأول", "متوسط")[
  $f'(x) = ((x - 1) - (x + 1))/(x - 1)^2 = (-2)/(x - 1)^2$. عند $x = 3$: $-2/4 = -1/2$. *الجواب: C*
  #distract[A ترتيب معكوس. B البسط $-2$ فقط. D خطأ في حساب المقام.]
]
#sol("الصفحة الرابعة: السؤال الثاني", "متوسط")[
  $f'(x) = (a (x + 2) - a x)/(x + 2)^2 = (2a)/(x + 2)^2$. \
  $f'(0) = (2a)/4 = a/2 = 3$ فإن $a = 6$. *الجواب: B*
  #distract[A $f'(0) = a$. C ضرب بدل قسمة على 2. D قسمة غير صحيحة.]
]
#sol("الصفحة الرابعة: السؤال الثالث", "متقدم")[
  $f'(x) = (2x (x - 2) - x^2)/(x - 2)^2 = (x^2 - 4x)/(x - 2)^2 = (x (x - 4))/(x - 2)^2$. \
  $f'(x) = 0$ عندما $x = 0$ أو $x = 4$. *الجواب: C*
  #distract[A و B حل واحد فقط. D $x = 2$ يجعل المقام صفرًا وليس البسط.]
]
#pagebreak()
#sol("حل السؤال التالي: الأصلي", "متقدم")[
  #part("A")[$u = x^2 + 1$ و $v = x - 2$. $f'(x) = (2x (x - 2) - (x^2 + 1)(1))/(x - 2)^2 = (x^2 - 4x - 1)/(x - 2)^2$.]
  #part("B")[$m = f'(3) = (9 - 12 - 1)/(1)^2 = -4$.]
  #part("C")[$f(3) = 10/1 = 10$. المعادلة: $y - 10 = -4(x - 3)$ أي $y = -4x + 22$.]
]
#sol("حل السؤال التالي: المشابه الأول", "متوسط")[
  #part("A")[$[u / v]'(1) = (3 dot 2 - 4 (-1))/(2)^2 = 10/4 = 5/2$.]
  #part("B")[$[v / u]'(1) = (v' u - v u')/u^2 = ((-1)(4) - (2)(3))/(4)^2 = (-10)/16 = -5/8$.]
  #part("C")[لا. $1 / ([u / v]'(1)) = 2/5$ بينما $[v / u]'(1) = -5/8$. مشتقة المقلوب ليست مقلوب المشتقة.]
]
#pagebreak()
#sol("حل السؤال التالي: المشابه الثاني (من الكتاب)", "متوسط")[
  #part("A")[$g'(x) = (0 dot (x^2 + 1) - 3 (2x))/(x^2 + 1)^2 = (-6x)/(x^2 + 1)^2$.]
  #part("B")[$g(1) = 3/2$ و $g'(1) = (-6)/4 = -3/2$. المعادلة: $y - 3/2 = -3/2 (x - 1)$ أي $y = -3/2 x + 3$.]
  #part("C")[$g'(x) = 0$ فإن $-6x = 0$ أي $x = 0$ و $g(0) = 3$. النقطة: $(0, 3)$.]
]
#sol("حل السؤال التالي: المشابه الثالث", "متقدم")[
  #part("A")[$C'(t) = (5(t^2 + 4) - 5t (2t))/(t^2 + 4)^2 = (20 - 5t^2)/(t^2 + 4)^2$.]
  #part("B")[$C'(1) = 15/25 = 0.6$. يزداد التركيز بمعدل 0.6 ملغ/لتر لكل ساعة عند $t = 1$.]
  #part("C")[$20 - 5t^2 = 0$ فإن $t = 2$ ($t > 0$). $C(2) = 10/8 = 1.25$ ملغ/لتر. المشتقة موجبة قبل $t = 2$ وسالبة بعده، فهي قيمة عظمى.]
]
#pagebreak()
#sol("حل السؤال التالي: المشابه الرابع", "متقدم")[
  #part("A")[$f'(x) = (3 (x + 2) - (3x - 1)(1))/(x + 2)^2 = 7/(x + 2)^2$.]
  #part("B")[البسط $7 > 0$ والمقام $(x + 2)^2 > 0$ لكل $x eq.not -2$، فإن $f'(x) > 0$ في مجال الدالة.]
  #part("C")[$7/(x + 2)^2 = 7/16$ فإن $(x + 2)^2 = 16$ أي $x + 2 = 4$ أو $x + 2 = -4$. إذن $x = 2$ أو $x = -6$.]
]
